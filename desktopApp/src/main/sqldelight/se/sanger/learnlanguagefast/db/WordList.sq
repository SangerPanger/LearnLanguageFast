CREATE TABLE WordList (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL
);

insertList:
INSERT INTO WordList(title) VALUES (?);

getAllLists:
SELECT * FROM WordList ORDER BY id;

getListById:
SELECT * FROM WordList WHERE id = ?;

updateListTitle:
UPDATE WordList SET title = ? WHERE id = ?;

deleteList:
DELETE FROM WordList WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();
